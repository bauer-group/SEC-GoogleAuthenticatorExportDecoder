{
  "name": "google-authenticator-export-decoder",
  "version": "0.1.4",
  "description": "PWA to scan Google Authenticator export QR codes and export TOTP secrets to CSV, JSON, or Bitwarden format",
  "author": "Karl Bauer <karl.bauer@bauer-group.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npx vite",
    "build": "npx tsc --noEmit && npx vite build",
    "preview": "npx vite preview",
    "test": "npx vitest",
    "test:run": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "type-check": "npx tsc --noEmit",
    "clean": "npx rimraf dist node_modules/.vite",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "keywords": [
    "2fa",
    "google",
    "authenticator",
    "export",
    "migrate",
    "totp",
    "qr-code",
    "bitwarden",
    "vaultwarden",
    "pwa"
  ],
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hi-base32": "^0.7.0",
    "html5-qrcode": "^2.3.8",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.1.0",
    "lucide-react": "^1.77.0",
    "protobufjs": "^8.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
